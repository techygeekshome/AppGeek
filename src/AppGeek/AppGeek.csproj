<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Allows the project to be built on non-Windows build agents. Harmless on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AppGeek</AssemblyName>
    <RootNamespace>AppGeek</RootNamespace>
    <Version>1.1.4</Version>
    <Company>TechyGeeksHome</Company>
    <Product>AppGeek</Product>
    <Description>Scan, update and install Windows applications. Part of the TechyGeeksHome Geek series.</Description>
    <Copyright>Copyright © TechyGeeksHome</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Multi-resolution icon (256/128/64/48/32/16), generated by tools/make-icon.py -->
    <ApplicationIcon>..\..\icons\appgeek.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WindowsDesktop SDK's implicit usings do not include these. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\catalogue.json" />
    <EmbeddedResource Include="Assets\catalogue.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked rather than copied: icons/ stays the single source of truth,
         which is also where the README and the GitHub release assets read from. -->
    <Resource Include="..\..\icons\appgeek.png" Link="Assets\appgeek.png" />
  </ItemGroup>

</Project>
