<UserControl x:Class="AppGeek.Views.FirstRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Navy}">

    <DockPanel LastChildFill="True">

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Chrome}"
                BorderBrush="#FF161D2C" BorderThickness="0,1,0,0" Padding="26,12">
            <Grid>
                <TextBlock Text="Version 1.0.0 · TechyGeeksHome" Foreground="{StaticResource Txt4}"
                           FontSize="12" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Skip for now" Style="{StaticResource GhostButton}"
                            Command="{Binding SkipCommand}" Margin="0,0,9,0" />
                    <Button Content="{Binding StartButtonLabel}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding StartCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,34,40,24">
            <StackPanel MaxWidth="720" HorizontalAlignment="Center">

                <Image Source="/Assets/appgeek.png" Width="84" Height="84"
                       HorizontalAlignment="Center" Margin="0,0,0,22"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <TextBlock Text="Welcome to AppGeek" FontSize="27" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="480"
                           TextWrapping="Wrap" Foreground="{StaticResource Txt2}" FontSize="14"
                           Margin="0,10,0,26"
                           Text="One place to keep every app on this PC up to date — and to install new ones without hunting for download links or clicking through installers." />

                <!-- Steps -->
                <UniformGrid Rows="1" Columns="3" Margin="0,0,0,22">
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel Margin="15">
                            <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource BlueDim}"
                                    HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="1" FontSize="12" FontWeight="Bold" Foreground="#FF7FB3F2"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Scan this PC" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"
                                       Text="AppGeek reads your installed programs list and matches it against known package sources. Nothing leaves this machine." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel Margin="15">
                            <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource BlueDim}"
                                    HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="2" FontSize="12" FontWeight="Bold" Foreground="#FF7FB3F2"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Review updates" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"
                                       Text="You see exactly what is out of date and what is changing. You tick what you want — nothing installs on its own." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Margin="15">
                            <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource BlueDim}"
                                    HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="3" FontSize="12" FontWeight="Bold" Foreground="#FF7FB3F2"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Add new apps" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"
                                       Text="Browse the catalogue, tick the apps you want, and AppGeek installs them silently in one run." />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Elevation notice -->
                <Border Background="#FF241D0C" BorderBrush="#FF4A3A14" BorderThickness="1"
                        CornerRadius="9" Padding="14,13" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7"
                                Background="{StaticResource Amber}" VerticalAlignment="Top">
                            <TextBlock Text="!" FontSize="13" FontWeight="Bold" Foreground="#FF1A1405"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="AppGeek is running with administrator rights"
                                       FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Foreground="#FFC7B489" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Text="Installing and updating software requires them, so AppGeek asks once when it starts rather than interrupting a run half way through. It still installs nothing without you ticking it first." />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Starter pack -->
                <TextBlock Text="OPTIONAL — STARTER PACK FOR A FRESH PC" Style="{StaticResource SectionLabel}"
                           Margin="0,6,0,11" />

                <ItemsControl ItemsSource="{Binding StarterPack}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,9,9" CornerRadius="10" BorderThickness="1" Padding="13" Height="72">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Panel}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="#FF101C31" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Blue}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource AppIcon}"
                                            Background="{Binding IconColour, Converter={StaticResource HexToBrush}}">
                                        <TextBlock Text="{Binding IconText}" Style="{StaticResource AppIconText}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Publisher}" Style="{StaticResource Muted}"
                                                   FontSize="11" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
