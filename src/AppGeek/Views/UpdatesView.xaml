<UserControl x:Class="AppGeek.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Navy}">

    <DockPanel LastChildFill="True">

        <!-- Header -->
        <Border DockPanel.Dock="Top" BorderBrush="#FF161D2C" BorderThickness="0,0,0,1" Padding="26,20,26,15">
            <StackPanel>
                <TextBlock Text="Updates" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding HeaderSummary}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Chrome}"
                BorderBrush="#FF161D2C" BorderThickness="0,1,0,0" Padding="26,12">
            <Grid>
                <TextBlock Text="{Binding SelectionSummary}" Foreground="{StaticResource Txt2}"
                           FontSize="13" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Select all" Command="{Binding SelectAllCommand}" Margin="0,0,9,0" />
                    <Button Content="Clear" Command="{Binding SelectNoneCommand}" Margin="0,0,9,0" />
                    <Button Content="{Binding InstallButtonLabel}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding InstallSelectedCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <DockPanel Margin="26,16,26,16" LastChildFill="True">

            <StackPanel DockPanel.Dock="Top">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Tag="Filter updates by name, publisher or package ID…"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                    <Button Grid.Column="1" Content="Re-scan" Command="{Binding ScanCommand}" Margin="10,0,0,0" />
                </Grid>

                <WrapPanel Margin="0,0,0,12">
                    <RadioButton Style="{StaticResource ChipButton}" GroupName="UpdFilter"
                                 IsChecked="{Binding FilterAll, Mode=OneWay}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="all">
                        <TextBlock><Run Text="All (" /><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ChipButton}" GroupName="UpdFilter"
                                 IsChecked="{Binding FilterSecurity, Mode=OneWay}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="security">
                        <TextBlock><Run Text="Security (" /><Run Text="{Binding SecurityCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ChipButton}" GroupName="UpdFilter"
                                 IsChecked="{Binding FilterMajor, Mode=OneWay}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="major">
                        <TextBlock><Run Text="Major version (" /><Run Text="{Binding MajorCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ChipButton}" GroupName="UpdFilter"
                                 IsChecked="{Binding FilterPinned, Mode=OneWay}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="pinned">
                        <TextBlock><Run Text="Pinned (" /><Run Text="{Binding PinnedCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                    </RadioButton>
                </WrapPanel>
            </StackPanel>

            <!-- Empty state -->
            <Border Style="{StaticResource Card}" Margin="0"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30,60">
                    <Border Width="52" Height="52" CornerRadius="14" Background="#FF123021"
                            HorizontalAlignment="Center">
                        <TextBlock Text="✓" FontSize="24" FontWeight="Bold" Foreground="{StaticResource GreenLight}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Nothing needs updating" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="Every tracked application on this PC is on its latest version."
                               Style="{StaticResource Muted}" FontSize="12.5" HorizontalAlignment="Center"
                               Margin="0,6,0,0" />
                    <Button Content="Re-scan this PC" Style="{StaticResource SmallButton}"
                            Command="{Binding ScanCommand}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                </StackPanel>
            </Border>

            <!-- List -->
            <Border Style="{StaticResource Card}" Margin="0"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <ListBox Style="{StaticResource PlainListBox}" ItemsSource="{Binding View}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RowBorder}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Pin this version — never offer an update"
                                                  Command="{Binding DataContext.PinCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Ignore this app entirely"
                                                  Command="{Binding DataContext.IgnoreCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center" Margin="0,0,13,0" />

                                    <Border Grid.Column="1" Style="{StaticResource AppIcon}"
                                            Background="{Binding IconColour, Converter={StaticResource HexToBrush}}">
                                        <TextBlock Text="{Binding IconText}" Style="{StaticResource AppIconText}" />
                                    </Border>

                                    <StackPanel Grid.Column="2" Margin="13,0,10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" />
                                            <Border Style="{StaticResource Tag}" Background="#FF3A1B10"
                                                    BorderBrush="#FF5A2E19" BorderThickness="1"
                                                    Visibility="{Binding IsSecuritySensitive, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="SECURITY" Style="{StaticResource TagText}" Foreground="#FFF0916B" />
                                            </Border>
                                            <Border Style="{StaticResource Tag}" Background="#FF102A38"
                                                    BorderBrush="#FF1B4657" BorderThickness="1"
                                                    Visibility="{Binding IsMajorVersionChange, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="MAJOR" Style="{StaticResource TagText}" Foreground="#FF5CC8D6" />
                                            </Border>
                                            <Border Style="{StaticResource Tag}" Background="#FF2A2410"
                                                    BorderBrush="#FF4A4020" BorderThickness="1"
                                                    Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="PINNED" Style="{StaticResource TagText}" Foreground="#FFD9BC5E" />
                                            </Border>
                                            <Border Style="{StaticResource Tag}" Background="#FF151D2E"
                                                    BorderBrush="#FF26314A" BorderThickness="1"
                                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="RUNNING" Style="{StaticResource TagText}" Foreground="#FF8A96AC" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SubtitleDisplay}" Style="{StaticResource Muted}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="0,0,16,0">
                                        <TextBlock Text="{Binding CurrentVersion}" Style="{StaticResource Muted}"
                                                   FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="→" Foreground="#FF4A5468" Margin="7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding AvailableVersion}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource GreenLight}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="4" Text="{Binding SizeDisplay}" Style="{StaticResource Muted}"
                                               FontSize="12" MinWidth="62" TextAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>
    </DockPanel>
</UserControl>
