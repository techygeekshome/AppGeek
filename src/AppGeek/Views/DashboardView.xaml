<UserControl x:Class="AppGeek.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Navy}">

    <DockPanel LastChildFill="True">

        <!-- Header -->
        <Border DockPanel.Dock="Top" BorderBrush="#FF161D2C" BorderThickness="0,0,0,1" Padding="26,20,26,15">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}">
                        <Run Text="{Binding MachineDescription, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding LastScanDisplay, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <Button Command="{Binding ScanCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                            <Setter Property="Content" Value="Re-scan this PC" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Shell.IsScanning}" Value="True">
                                    <Setter Property="Content" Value="Scanning…" />
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,20,26,24">
            <StackPanel>

                <!-- Scanning: the first scan takes a while, and silence reads as a hang -->
                <Border Style="{StaticResource Card}" BorderBrush="#FF2B4A79"
                        Visibility="{Binding Shell.IsScanning, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="19,17">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Scanning this PC" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Foreground="{StaticResource Txt3}" FontSize="12.5" Margin="0,4,0,0">
                                <Run Text="{Binding Shell.ScanStepLabel, Mode=OneWay}" Foreground="#FF5C6578" />
                                <Run Text="  ·  " Foreground="#FF5C6578" />
                                <Run Text="{Binding Shell.ScanStatus, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Shell.ScanPercentText}"
                                   FontSize="30" FontWeight="Bold" Foreground="{StaticResource BlueLight}"
                                   VerticalAlignment="Center" />

                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="7" Margin="0,15,0,0"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding Shell.ScanPercent, Mode=OneWay}" />
                    </Grid>
                </Border>

                <!-- Stat tiles -->
                <UniformGrid Rows="1" Columns="4" Margin="0,0,0,22">
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" BorderBrush="#FF2B4A79">
                        <Grid>
                            <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource Blue}"
                                    CornerRadius="10,0,0,10" />
                            <StackPanel Margin="17,16">
                                <TextBlock Text="UPDATES AVAILABLE" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding UpdateCount}" FontSize="30" FontWeight="Bold"
                                           Foreground="{StaticResource BlueLight}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding DownloadSizeDisplay, StringFormat={}{0} to download}"
                                           Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" BorderBrush="#FF5A3520">
                        <Grid>
                            <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource Orange}"
                                    CornerRadius="10,0,0,10" />
                            <StackPanel Margin="17,16">
                                <TextBlock Text="SECURITY UPDATES" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding SecurityCount}" FontSize="30" FontWeight="Bold"
                                           Foreground="{StaticResource OrangeLight}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding SecuritySubtitle}" Style="{StaticResource Muted}"
                                           FontSize="12" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <Grid>
                            <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource Green}"
                                    CornerRadius="10,0,0,10" />
                            <StackPanel Margin="17,16">
                                <TextBlock Text="APPS INSTALLED" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding InstalledCount}" FontSize="30" FontWeight="Bold"
                                           Margin="0,8,0,0" />
                                <TextBlock Text="{Binding TrackedCount, StringFormat={}{0} matched to a source}"
                                           Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Border Width="3" HorizontalAlignment="Left" Background="#FF3E4A63"
                                    CornerRadius="10,0,0,10" />
                            <StackPanel Margin="17,16">
                                <TextBlock Text="UP TO DATE" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding UpToDateCount}" FontSize="30" FontWeight="Bold"
                                           Margin="0,8,0,0" />
                                <TextBlock Text="No action needed" Style="{StaticResource Muted}"
                                           FontSize="12" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- Needs attention -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <Grid>
                                <TextBlock Text="Needs attention" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock HorizontalAlignment="Right" Style="{StaticResource Muted}" FontSize="12"
                                           Text="{Binding UpdateCount, StringFormat={}{0} apps out of date}" />
                            </Grid>
                        </Border>

                        <!-- Empty state -->
                        <StackPanel Margin="17,26" HorizontalAlignment="Center"
                                    Visibility="{Binding UpdateCount, Converter={StaticResource CountToVis}, ConverterParameter=empty}">
                            <TextBlock Text="Everything is up to date" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Nothing on this PC needs updating right now."
                                       Style="{StaticResource Muted}" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding UpdateCount, Converter={StaticResource CountToVis}}">
                            <ItemsControl ItemsSource="{Binding TopUpdates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RowBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Style="{StaticResource AppIcon}"
                                                        Background="{Binding IconColour, Converter={StaticResource HexToBrush}}">
                                                    <TextBlock Text="{Binding IconText}" Style="{StaticResource AppIconText}" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="13,0,10,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" />
                                                        <Border Style="{StaticResource Tag}" Background="#FF3A1B10"
                                                                BorderBrush="#FF5A2E19" BorderThickness="1"
                                                                Visibility="{Binding IsSecuritySensitive, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="SECURITY" Style="{StaticResource TagText}"
                                                                       Foreground="#FFF0916B" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SubtitleDisplay}" Style="{StaticResource Muted}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CurrentVersion}" Style="{StaticResource Muted}"
                                                               FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="→" Foreground="#FF4A5468" Margin="7,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding AvailableVersion}" FontSize="12"
                                                               FontWeight="SemiBold" Foreground="{StaticResource GreenLight}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="View all updates" Style="{StaticResource SmallButton}"
                                    Command="{Binding GoToUpdatesCommand}"
                                    HorizontalAlignment="Center" Margin="0,11,0,11" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Quick actions + activity -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                                <TextBlock Text="Quick actions" FontSize="13.5" FontWeight="SemiBold" />
                            </Border>
                            <StackPanel Margin="17,16">
                                <Button Style="{StaticResource LeftPrimaryButton}"
                                        Content="{Binding UpdateEverythingLabel}"
                                        Command="{Binding UpdateEverythingCommand}"
                                        IsEnabled="{Binding HasUpdates}" Margin="0,0,0,9" />
                                <Button Style="{StaticResource LeftButton}" Content="Browse the app catalogue"
                                        Command="{Binding GoToCatalogueCommand}" Margin="0,0,0,9" />
                                <Button Style="{StaticResource LeftButton}" Content="Export an inventory report"
                                        Command="{Binding ExportReportCommand}" Margin="0,0,0,9" />
                                <Button Style="{StaticResource LeftButton}" Content="Re-scan this PC"
                                        Command="{Binding ScanCommand}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                                <TextBlock Text="Recent activity" FontSize="13.5" FontWeight="SemiBold" />
                            </Border>
                            <StackPanel Margin="0,6,0,10">
                                <TextBlock Text="Nothing has happened yet." Style="{StaticResource Muted}"
                                           Margin="17,10"
                                           Visibility="{Binding RecentActivity.Count, Converter={StaticResource CountToVis}, ConverterParameter=empty}" />
                                <ItemsControl ItemsSource="{Binding RecentActivity}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="17,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                                                        VerticalAlignment="Top" Margin="0,1,0,0"
                                                        Background="{Binding Kind, Converter={StaticResource ActivityBrush}}">
                                                    <TextBlock Text="{Binding Glyph}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{StaticResource Txt2}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                                    <TextBlock Text="{Binding Text}" Foreground="{StaticResource Txt2}"
                                                               FontSize="12.5" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding WhenDisplay}" Style="{StaticResource Muted}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
