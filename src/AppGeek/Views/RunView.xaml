<UserControl x:Class="AppGeek.Views.RunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Navy}">

    <DockPanel LastChildFill="True">

        <!-- Header -->
        <Border DockPanel.Dock="Top" BorderBrush="#FF161D2C" BorderThickness="0,0,0,1" Padding="26,20,26,15">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
                <ProgressBar Height="7" Margin="0,13,0,0" Minimum="0" Maximum="100"
                             Value="{Binding OverallProgress, Mode=OneWay}"
                             Visibility="{Binding Items.Count, Converter={StaticResource CountToVis}}" />
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Chrome}"
                BorderBrush="#FF161D2C" BorderThickness="0,1,0,0" Padding="26,12">
            <Grid>
                <TextBlock Text="{Binding FooterSummary}" Foreground="{StaticResource Txt2}"
                           FontSize="13" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox Content="Shut down when finished" IsChecked="{Binding ShutdownWhenDone}"
                              VerticalAlignment="Center" Margin="0,0,16,0"
                              Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Open log" Command="{Binding OpenLogCommand}" Margin="0,0,9,0" />
                    <Button Content="Stop after current app" Style="{StaticResource DangerButton}"
                            Command="{Binding StopCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Back to dashboard" Style="{StaticResource PrimaryButton}"
                            Command="{Binding BackCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <ScrollViewer Margin="26,16,26,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Empty state -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding Items.Count, Converter={StaticResource CountToVis}, ConverterParameter=empty}">
                    <StackPanel Margin="30,50" HorizontalAlignment="Center">
                        <TextBlock Text="No run yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Start an update or install from the Updates or Catalogue page and the progress will show here."
                                   Style="{StaticResource Muted}" FontSize="12.5" HorizontalAlignment="Center"
                                   TextAlignment="Center" MaxWidth="360" TextWrapping="Wrap" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <!-- Items -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding Items.Count, Converter={StaticResource CountToVis}}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <TextBlock Text="Run progress" FontSize="13.5" FontWeight="SemiBold" />
                        </Border>

                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RowBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding State, Converter={StaticResource RunStateBrush}}">
                                                <TextBlock Text="{Binding State, Converter={StaticResource RunStateGlyph}}"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="{Binding State, Converter={StaticResource RunStateForeground}}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <Border Grid.Column="1" Style="{StaticResource AppIcon}" Margin="13,0,0,0"
                                                    Background="{Binding IconColour, Converter={StaticResource HexToBrush}}">
                                                <TextBlock Text="{Binding IconText}" Style="{StaticResource AppIconText}" />
                                            </Border>

                                            <StackPanel Grid.Column="2" Margin="13,0,12,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" />
                                                    <Border Style="{StaticResource Tag}" Background="#FF3A1B10"
                                                            BorderBrush="#FF5A2E19" BorderThickness="1"
                                                            Visibility="{Binding IsSecuritySensitive, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="SECURITY" Style="{StaticResource TagText}"
                                                                   Foreground="#FFF0916B" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"
                                                           Margin="0,2,0,0" />
                                                <ProgressBar Height="4" Margin="0,7,0,0" Minimum="0" Maximum="100"
                                                             Value="{Binding Percent, Mode=OneWay}"
                                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="12"
                                                       VerticalAlignment="Center" MinWidth="56" TextAlignment="Right"
                                                       Foreground="{Binding State, Converter={StaticResource RunStateForeground}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- Log -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding Items.Count, Converter={StaticResource CountToVis}}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <TextBlock Text="Live log" FontSize="13.5" FontWeight="SemiBold" />
                        </Border>
                        <Border Margin="17,14" Background="#FF080B12" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10" Height="180">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                         Foreground="#FF8D97AB" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Disabled" />
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
