<UserControl x:Class="AppGeek.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Navy}">

    <UserControl.Resources>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource LineSoft}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="17,14" />
        </Style>
        <!-- BasedOn is load-bearing: without it a keyed style does not inherit the
             implicit TextBlock style, and Foreground falls back to black on a dark page. -->
        <Style x:Key="SettingTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Txt}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SettingDetail" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Txt3}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="560" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <Border DockPanel.Dock="Top" BorderBrush="#FF161D2C" BorderThickness="0,0,0,1" Padding="26,20,26,15">
            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Scanning, sources, install behaviour and exclusions"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Chrome}"
                BorderBrush="#FF161D2C" BorderThickness="0,1,0,0" Padding="26,12">
            <Grid>
                <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource Txt4}"
                           FontSize="12" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Export diagnostics" Command="{Binding ExportDiagnosticsCommand}"
                            ToolTip="Bundles the logs, settings and PC details into a zip for a bug report. Nothing is uploaded."
                            Margin="0,0,9,0" />
                    <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" Margin="0,0,9,0" />
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Margin="26,16,26,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Scanning -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <TextBlock Text="Scanning" FontSize="13.5" FontWeight="SemiBold" />
                        </Border>
                        <StackPanel>
                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Scan automatically" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Style="{StaticResource SettingDetail}"
                                                   Text="Check for available updates in the background. AppGeek never installs anything on its own — it only tells you what is available." />
                                    </StackPanel>
                                    <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" IsChecked="{Binding AutoScan}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Schedule" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Style="{StaticResource SettingDetail}"
                                                   Text="How often the background scan runs." />
                                        <TextBlock Style="{StaticResource SettingDetail}" Margin="0,4,0,0"
                                                   Text="{Binding SchedulePreview}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="190"
                                              ItemsSource="{Binding ScheduleOptions}"
                                              SelectedItem="{Binding ScanSchedule}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Notify me when updates are found" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Style="{StaticResource SettingDetail}"
                                                   Text="A Windows notification with the count and a link straight to the update list." />
                                    </StackPanel>
                                    <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" IsChecked="{Binding NotifyOnUpdates}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Include Microsoft Store apps" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Style="{StaticResource SettingDetail}"
                                                   Text="Adds Store-delivered apps to the inventory. Slower, because it has to ask Windows rather than read the registry." />
                                    </StackPanel>
                                    <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" IsChecked="{Binding IncludeStoreApps}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Include apps with an unknown version" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Style="{StaticResource SettingDetail}"
                                                   Text="Some installers do not record their version. Including them finds more updates but produces the occasional false positive." />
                                    </StackPanel>
                                    <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" IsChecked="{Binding IncludeUnknownVersions}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Sources -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <TextBlock Text="Sources" FontSize="13.5" FontWeight="SemiBold" />
                        </Border>
                        <StackPanel>
                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Windows Package Manager (winget)" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Style="{StaticResource SettingDetail}"
                                                   Text="The primary source. Provides package matching, silent install switches and hash verification." />
                                        <TextBlock Text="{Binding WingetStatus}" FontSize="12" Margin="0,5,0,0"
                                                   Foreground="{StaticResource GreenLight}" />
                                    </StackPanel>
                                    <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" IsChecked="{Binding UseWinget}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Microsoft Store" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Style="{StaticResource SettingDetail}"
                                                   Text="Used for Store-delivered apps such as Windows Terminal and Spotify." />
                                    </StackPanel>
                                    <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" IsChecked="{Binding UseMicrosoftStore}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="TechyGeeksHome catalogue" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Style="{StaticResource SettingDetail}"
                                                   Text="Our curated list: categories, icons and the handful of apps winget does not carry. A copy is built into AppGeek and works offline — the address below is only where a newer list is fetched from, so the catalogue can change without shipping a new version." />
                                        <TextBlock Text="{Binding CatalogueStatus}" FontSize="12" Margin="0,5,0,0"
                                                   Foreground="{StaticResource Txt3}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBox Text="{Binding CatalogueUrl}" Width="380" FontSize="12" />
                                            <Button Content="Refresh now" Style="{StaticResource SmallButton}"
                                                    Command="{Binding RefreshCatalogueCommand}" Margin="9,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                                  VerticalAlignment="Top" IsChecked="{Binding UseTghCatalogue}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Install behaviour -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <TextBlock Text="Install behaviour" FontSize="13.5" FontWeight="SemiBold" />
                        </Border>
                        <StackPanel>
                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="When an app is running" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Style="{StaticResource SettingDetail}"
                                                   Text="Updating a running app usually fails. AppGeek can ask you, skip it, or close it first." />
                                    </StackPanel>
                                    <ComboBox HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="170"
                                              ItemsSource="{Binding RunningAppOptions}"
                                              SelectedItem="{Binding RunningAppPolicyText}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Create a restore point before a run" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Style="{StaticResource SettingDetail}"
                                                   Text="Adds roughly 20–30 seconds to the start of a run. Needs System Protection to be enabled." />
                                    </StackPanel>
                                    <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" IsChecked="{Binding CreateRestorePoint}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Reboot handling" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Style="{StaticResource SettingDetail}"
                                                   Text="Some installers request a restart. AppGeek never reboots without telling you." />
                                    </StackPanel>
                                    <ComboBox HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="190"
                                              ItemsSource="{Binding RebootOptions}"
                                              SelectedItem="{Binding RebootPolicyText}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Keep downloaded installers" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Style="{StaticResource SettingDetail}"
                                                   Text="Useful when re-imaging the same machine, at the cost of disk space." />
                                        <TextBlock Text="{Binding CachePath}" Style="{StaticResource Muted}" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" IsChecked="{Binding KeepInstallers}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Exclusions -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <Grid>
                                <TextBlock Text="Exclusions and pinned versions" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ExclusionSummary}" HorizontalAlignment="Right"
                                           Style="{StaticResource Muted}" FontSize="12" />
                            </Grid>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Margin="17,16" TextWrapping="Wrap"
                                       Text="Right-click any app on the Updates or Installed page to pin its version or hide it. Pinned apps are never offered for update — useful when a line-of-business tool depends on a specific runtime."
                                       Visibility="{Binding Exclusions.Count, Converter={StaticResource CountToVis}, ConverterParameter=empty}" />

                            <ItemsControl ItemsSource="{Binding Exclusions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RowBorder}">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13.5" />
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button Content="Remove" Style="{StaticResource SmallButton}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.RemoveExclusionCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
