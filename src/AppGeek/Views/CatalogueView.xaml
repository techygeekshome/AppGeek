<UserControl x:Class="AppGeek.Views.CatalogueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Navy}">

    <DockPanel LastChildFill="True">

        <!-- Header -->
        <Border DockPanel.Dock="Top" BorderBrush="#FF161D2C" BorderThickness="0,0,0,1" Padding="26,20,26,15">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Catalogue" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Tick the apps you want, then install them all in one silent run — no next-next-finish"
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <TextBlock Text="{Binding CatalogueSummary}" Style="{StaticResource Muted}"
                           HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Chrome}"
                BorderBrush="#FF161D2C" BorderThickness="0,1,0,0" Padding="26,12">
            <Grid>
                <TextBlock Text="{Binding SelectionSummary}" Foreground="{StaticResource Txt2}"
                           FontSize="13" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Refresh catalogue" Command="{Binding RefreshCatalogueCommand}" Margin="0,0,9,0" />
                    <Button Content="Clear" Style="{StaticResource GhostButton}"
                            Command="{Binding ClearCommand}" Margin="0,0,9,0" />
                    <Button Content="{Binding InstallButtonLabel}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding InstallSelectedCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <DockPanel Margin="26,16,26,16" LastChildFill="True">

            <StackPanel DockPanel.Dock="Top">
                <TextBox Tag="Search the catalogue…" Margin="0,0,0,12"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" />

                <ItemsControl ItemsSource="{Binding Categories}" Margin="0,0,0,10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource ChipButton}" GroupName="CatFilter"
                                         Content="{Binding}"
                                         Command="{Binding DataContext.SetCategoryCommand,
                                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         CommandParameter="{Binding}">
                                <RadioButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource MultiEquals}" Mode="OneWay">
                                        <Binding Path="DataContext.Category"
                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        <Binding />
                                    </MultiBinding>
                                </RadioButton.IsChecked>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <ListBox Style="{StaticResource PlainListBox}" ItemsSource="{Binding View}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Grid Margin="0,14,0,10" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               Style="{StaticResource SectionLabel}" FontSize="11.5" />
                                    <Border Grid.Column="1" Height="1" Background="#FF1A2233"
                                            VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                        <GroupStyle.Panel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GroupStyle.Panel>
                    </GroupStyle>
                </ListBox.GroupStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="248" Height="86" Margin="0,0,11,11" CornerRadius="10"
                                BorderThickness="1" Padding="14">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Panel}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Panel2}" />
                                            <Setter Property="BorderBrush" Value="#FF37507A" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#FF101C31" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Blue}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource AppIcon}" VerticalAlignment="Top"
                                        Background="{Binding IconColour, Converter={StaticResource HexToBrush}}">
                                    <TextBlock Text="{Binding IconText}" Style="{StaticResource AppIconText}" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,6,0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" />
                                    <TextBlock Text="{Binding Publisher}" Style="{StaticResource Muted}"
                                               FontSize="11" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding FooterText}" Foreground="{StaticResource Txt4}"
                                               FontSize="10.5" Margin="0,6,0,0" />
                                </StackPanel>

                                <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" />
                            </Grid>

                            <Border.ToolTip>
                                <ToolTip>
                                    <StackPanel MaxWidth="280">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Txt}" />
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Txt2}" Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding WingetId, StringFormat=Package: {0}}"
                                                   Foreground="{StaticResource Txt4}" FontSize="11" Margin="0,7,0,0" />
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DockPanel>
</UserControl>
