<Application x:Class="AppGeek.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AppGeek.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:HexToBrushConverter x:Key="HexToBrush" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:StringToVisibilityConverter x:Key="StringToVis" />
            <conv:EqualsConverter x:Key="Equals" />
            <conv:MultiEqualsConverter x:Key="MultiEquals" />
            <conv:CountToVisibilityConverter x:Key="CountToVis" />
            <conv:RunStateToBrushConverter x:Key="RunStateBrush" />
            <conv:RunStateToForegroundConverter x:Key="RunStateForeground" />
            <conv:RunStateToGlyphConverter x:Key="RunStateGlyph" />
            <conv:ActivityKindToBrushConverter x:Key="ActivityBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
