<Window x:Class="AppGeek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AppGeek.ViewModels"
        xmlns:views="clr-namespace:AppGeek.Views"
        Title="AppGeek" Height="940" Width="1180" MinHeight="480" MinWidth="860"
        Icon="/Assets/appgeek.png"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Navy}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:FirstRunViewModel}">
            <views:FirstRunView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UpdatesViewModel}">
            <views:UpdatesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CatalogueViewModel}">
            <views:CatalogueView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstalledViewModel}">
            <views:InstalledView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RunViewModel}">
            <views:RunView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Navigation rail ============ -->
        <Border Grid.Column="0" Width="212" Background="{StaticResource Chrome}"
                BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,1,0"
                Visibility="{Binding ShowNavigation, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">

                <!-- Brand -->
                <Grid DockPanel.Dock="Top" Margin="16,18,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="/Assets/appgeek.png" Width="38" Height="38"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BrandName}" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="{Binding BrandBy}" Foreground="{StaticResource Txt3}"
                                   FontSize="10.5" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Footer -->
                <StackPanel DockPanel.Dock="Bottom" Margin="14,10,14,14">

                    <Border Background="#FF241D0C" BorderBrush="#FF4A3A14" BorderThickness="1"
                            CornerRadius="6" Padding="9,6" Margin="0,0,0,10"
                            Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="ADMINISTRATOR" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource Amber}" HorizontalAlignment="Center" />
                    </Border>

                    <Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}"
                            HorizontalAlignment="Stretch" Padding="12,9" Margin="0,0,0,7" />
                    <Button Content="{Binding AboutButtonLabel}" Command="{Binding ShowAboutCommand}"
                            HorizontalAlignment="Stretch" Padding="12,9" />

                    <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource Txt4}"
                               FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>

                <!-- Items. Scrollable so a short window never clips the footer buttons. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding NavItems}" Margin="10,4,10,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Group heading -->
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}"
                                           Margin="10,14,0,6"
                                           Visibility="{Binding IsGroupHeader, Converter={StaticResource BoolToVis}}" />

                                <!-- Clickable item -->
                                <Button Command="{Binding DataContext.NavigateCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Key}"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="10,9" Margin="0,0,0,2"
                                        Visibility="{Binding IsGroupHeader, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{StaticResource Txt2}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BlueDim}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6"
                                                Background="#FF1E2637" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FF1E2637" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource Blue}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                                       FontSize="11" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" FontSize="13.5"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />

                                        <Border Grid.Column="2" CornerRadius="9" Padding="7,1"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource Blue}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BadgeIsAccent}" Value="False">
                                                            <Setter Property="Background" Value="#FF1E2637" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Badge}" FontSize="10.5" FontWeight="Bold"
                                                       Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============ Page host ============ -->
        <DockPanel Grid.Column="1" LastChildFill="True">

            <!-- Dependency banner: shown when App Installer / winget is missing or too old -->
            <Border DockPanel.Dock="Top" Background="#FF2A1D0C" BorderBrush="#FF5A3F14"
                    BorderThickness="0,0,0,1" Padding="22,14"
                    Visibility="{Binding ShowDependencyBanner, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8"
                            Background="{StaticResource Amber}" VerticalAlignment="Top">
                        <TextBlock Text="!" FontSize="16" FontWeight="Bold" Foreground="#FF1A1405"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,16,0">
                        <TextBlock Text="{Binding Dependency.Headline}" FontSize="13.5"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Dependency.Detail}" Foreground="#FFC7B489"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Check again" Style="{StaticResource SmallButton}"
                                Command="{Binding RecheckDependencyCommand}" Margin="0,0,8,0" />
                        <Button Content="Open Store" Style="{StaticResource SmallButton}"
                                Command="{Binding OpenStoreCommand}" Margin="0,0,8,0" />
                        <Button Content="{Binding FixButtonLabel}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding FixWingetCommand}" Padding="13,6" Margin="0,0,8,0" />
                        <Button Content="✕" Style="{StaticResource GhostButton}" Padding="8,5"
                                ToolTip="Dismiss for this session"
                                Command="{Binding DismissDependencyCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status strip: scan progress while scanning, update-check result otherwise -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource Chrome}"
                    BorderBrush="#FF161D2C" BorderThickness="0,1,0,0" Padding="26,9"
                    Visibility="{Binding ShowStatusStrip, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <!-- Idle: the last update-check message -->
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Txt2}"
                               FontSize="12.5" TextWrapping="Wrap"
                               Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                    <!-- Scanning: live progress, visible from every page -->
                    <Grid Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Foreground="{StaticResource Txt2}" FontSize="12.5"
                                   VerticalAlignment="Center" Margin="0,0,14,0">
                            <Run Text="{Binding ScanStepLabel, Mode=OneWay}" Foreground="#FF5C6578" />
                            <Run Text="  " />
                            <Run Text="{Binding ScanStatus, Mode=OneWay}" />
                        </TextBlock>

                        <ProgressBar Grid.Column="1" Height="5" Minimum="0" Maximum="100"
                                     Value="{Binding ScanPercent, Mode=OneWay}"
                                     VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2" Text="{Binding ScanPercentText}" MinWidth="42"
                                   TextAlignment="Right" Foreground="{StaticResource BlueLight}"
                                   FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="14,0,0,0" />
                    </Grid>
                </Grid>
            </Border>

            <ContentControl Content="{Binding CurrentPage}" />
        </DockPanel>
    </Grid>
</Window>
